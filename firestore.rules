rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /tasks/{taskId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (resource.data.createdBy == request.auth.uid || request.auth.uid in resource.data.assignees);
      allow update, delete: if request.auth != null && (resource.data.createdBy == request.auth.uid || request.auth.uid in resource.data.assignees);
    }
    match /reminders/{reminderId} {
      allow read, write: if false;
    }
  }
}
